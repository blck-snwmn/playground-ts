{
	"name": "sample-neverthrow",
	"version": "1.0.0",
	"description": "Sample project demonstrating neverthrow usage",
	"type": "module",
	"scripts": {
		"dev": "tsx index.ts",
		"build": "tsc",
		"start": "node dist/index.js",
		"lint": "oxlint --deny-warnings .",
		"lint:fix": "oxlint --deny-warnings . --fix",
		"fmt": "oxfmt --write $(git ls-files '*.js' '*.jsx' '*.ts' '*.tsx' '*.mjs' '*.cjs')",
		"fmt:check": "oxfmt --check $(git ls-files '*.js' '*.jsx' '*.ts' '*.tsx' '*.mjs' '*.cjs')"
	},
	"devDependencies": {
		"@types/node": "22.18.13",
		"tsx": "4.20.6",
		"typescript": "5.9.3",
		"oxfmt": "^0.48.0",
		"oxlint": "^1.63.0",
		"oxlint-tsgolint": "^0.22.1"
	},
	"dependencies": {
		"neverthrow": "^8.2.0"
	}
}
