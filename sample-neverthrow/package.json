{
	"name": "sample-neverthrow",
	"version": "1.0.0",
	"description": "Sample project demonstrating neverthrow usage",
	"type": "module",
	"scripts": {
		"dev": "tsx index.ts",
		"build": "tsc",
		"start": "node dist/index.js",
		"lint": "oxlint --deny-warnings .",
		"lint:fix": "oxlint --deny-warnings . --fix",
		"fmt": "oxfmt --write $(git ls-files '*.js' '*.jsx' '*.ts' '*.tsx' '*.mjs' '*.cjs')",
		"fmt:check": "oxfmt --check $(git ls-files '*.js' '*.jsx' '*.ts' '*.tsx' '*.mjs' '*.cjs')"
	},
	"devDependencies": {
		"@types/node": "24.13.1",
		"tsx": "4.22.4",
		"typescript": "6.0.3",
		"oxfmt": "0.54.0",
		"oxlint": "1.69.0",
		"oxlint-tsgolint": "0.23.0"
	},
	"dependencies": {
		"neverthrow": "^8.2.0"
	}
}
