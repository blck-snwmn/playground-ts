{
	"name": "vitest-in-source-example",
	"version": "1.0.0",
	"description": "",
	"type": "module",
	"main": "index.js",
	"scripts": {
		"test": "vitest",
		"test:run": "vitest --run",
		"test:coverage": "vitest --run --coverage",
		"test:coverage:ui": "vitest --run --coverage --ui",
		"test:coverage:watch": "vitest --coverage",
		"lint": "oxlint --deny-warnings .",
		"lint:fix": "oxlint --deny-warnings . --fix",
		"fmt": "oxfmt --write $(git ls-files '*.js' '*.jsx' '*.ts' '*.tsx' '*.mjs' '*.cjs')",
		"fmt:check": "oxfmt --check $(git ls-files '*.js' '*.jsx' '*.ts' '*.tsx' '*.mjs' '*.cjs')"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devDependencies": {
		"@vitest/coverage-v8": "3.2.4",
		"@vitest/ui": "3.2.4",
		"typescript": "5.9.3",
		"vite": "7.3.3",
		"vitest": "3.2.4",
		"oxfmt": "^0.48.0",
		"oxlint": "^1.63.0",
		"oxlint-tsgolint": "^0.22.1"
	}
}
