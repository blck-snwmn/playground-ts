{
	"name": "playwright-component-test",
	"version": "1.0.0",
	"description": "Playwright component testing sample with React",
	"private": true,
	"scripts": {
		"test-ct": "playwright test -c playwright-ct.config.ts",
		"test-ct:ui": "playwright test -c playwright-ct.config.ts --ui",
		"lint": "oxlint --deny-warnings .",
		"lint:fix": "oxlint --deny-warnings . --fix",
		"fmt": "oxfmt --write $(git ls-files '*.js' '*.jsx' '*.ts' '*.tsx' '*.mjs' '*.cjs')",
		"fmt:check": "oxfmt --check $(git ls-files '*.js' '*.jsx' '*.ts' '*.tsx' '*.mjs' '*.cjs')"
	},
	"devDependencies": {
		"@playwright/experimental-ct-react": "1.60.0",
		"@playwright/test": "1.60.0",
		"@types/node": "24.13.1",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"oxfmt": "0.54.0",
		"oxlint": "1.75.0",
		"oxlint-tsgolint": "7.0.2001",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"typescript": "7.0.2",
		"vite": "8.0.16"
	}
}
